{
    "compilerOptions": {
        "allowJs": true,
        "alwaysStrict": true,
        // Explicitly set to false to support namespace imports (import * as name)
        "esModuleInterop": false,
        "ignoreDeprecations": "6.0",
        "lib": ["esnext", "dom"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "noEmitHelpers": true,
        "noImplicitAny": true,
        "useUnknownInCatchVariables": false,
        "strictNullChecks": false,
        "noImplicitReturns": true,
        "noUnusedLocals": false,
        "outDir": "dist",
        "resolveJsonModule": true,
        "sourceMap": true,
        "target": "esnext",
        "declaration": true
    },
    "typesRoots": ["node_modules/@types"],
    "include": ["lib/**/*", "index.ts"],
    "exclude": ["extras/**/*", "example/**/*", "tester/**/*", "Attic/**/*"],
    "typedocOptions": {
        "plugin": ["typedoc-theme-hierarchy"],
        "excludeExternals": true,
        "excludePrivate": true,
        "excludeProtected": false,
        "out": "docs",
        "theme": "hierarchy",
        "includeVersion": true,
        "categorizeByGroup": true,
        "gitRemote": "origin",
        "hideGenerator": true,
        "sort": ["static-first", "visibility"],
        "name": "Implementation of the RDF Canonicalization algorithm RDFC-1.0"
    }
}
